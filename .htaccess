# Samexxa SEO-friendly clean URLs
# Apache 2.4+ / cPanel

DirectoryIndex index.html
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 301 redirect old .html URLs to the canonical clean URL.
    # This rule must run before the real-file check.
    RewriteCond %{THE_REQUEST} \s/+(.+?)\.html(?:[?\s]) [NC]
    RewriteRule ^(.+)\.html$ /$1 [R=301,L,NE]

    # Keep existing files and directories (CSS, JS, images, etc.) working.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Internally serve /about from about.html, /contact from contact.html, etc.
    RewriteCond %{DOCUMENT_ROOT}/$1.html -f
    RewriteRule ^(.+?)/?$ $1.html [L]

    # Homepage.
    RewriteRule ^$ index.html [L]
</IfModule>
